[Unit]
Description=Ethereum Mainnet NFT Copy Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ethereum-nft-copy-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/ethereum-nft-copy-bot/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
