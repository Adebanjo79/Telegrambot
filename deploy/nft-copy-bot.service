[Unit]
Description=Ink Chain NFT Copy Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nft-copy-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nft-copy-bot/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
