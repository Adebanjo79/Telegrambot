# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Your Telegram numeric user id (bot only accepts commands from this id)
TELEGRAM_OWNER_ID=123456789

# Robinhood Chain RPC (public or Alchemy)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Wallet you want to COPY (the sniper / minter you follow)
TARGET_WALLET=0xTargetWalletAddressHere

# YOUR wallet private key (never share / never commit). Fund with ETH for gas.
PRIVATE_KEY=0xYourPrivateKeyHere

# Optional: only copy txs whose value is 0 (free mints). Default true.
FREE_MINTS_ONLY=true

# How often to poll new blocks (ms)
POLL_INTERVAL_MS=1200

# Max gas limit for copy mints
GAS_LIMIT=500000
