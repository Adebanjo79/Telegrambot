# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Your Telegram numeric user id (from @userinfobot)
TELEGRAM_OWNER_ID=123456789

# Ethereum Mainnet
NETWORK_NAME=Ethereum Mainnet
CHAIN_ID=1
# Free/public options (rate-limited):
#   https://ethereum.publicnode.com
#   https://cloudflare-eth.com
# Better: Alchemy / Infura / QuickNode Ethereum mainnet URL
RPC_URL=https://ethereum.publicnode.com
EXPLORER_URL=https://etherscan.io

# Wallet(s) you want to COPY on Ethereum — comma-separated allowed
TARGET_WALLETS=0xTargetWalletAddressHere

# YOUR wallet private key (needs ETH on Ethereum mainnet for gas)
PRIVATE_KEY=0xYourPrivateKeyHere

# true = only copy 0 ETH value mints
FREE_MINTS_ONLY=true

# true = simulate only (STRONGLY recommended first — Ethereum gas is expensive)
DRY_RUN=true

POLL_INTERVAL_SEC=2.0
GAS_LIMIT=500000
MAX_CATCHUP_BLOCKS=15
