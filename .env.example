# Use a NEW BotFather token. Do not share this with the Robinhood or Ethereum bots.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_OWNER_ID=123456789

NETWORK_NAME=Ink
CHAIN_ID=57073
EXPLORER_URL=https://explorer.inkonchain.com

# Public Ink RPCs. Prefer a paid Alchemy/Chainstack/QuickNode Ink URL in production.
RPC_URL=https://rpc-gel.inkonchain.com
# First URL is primary, the rest are backups.
# RPC_URLS=https://ink-mainnet.g.alchemy.com/v2/YOUR_KEY,https://rpc-qnd.inkonchain.com
RPC_LOAD_BALANCE=false
RPC_FAILBACK_SEC=30
RPC_RATE_LIMIT=25
RPC_WARN_PERCENT=80
RPC_SLOW_MS=1500

PENDING_DETECTION=false
PENDING_WS_URL=
PENDING_SUBSCRIPTION=auto

TARGET_WALLETS=0xTargetWalletAddressHere
PRIVATE_KEYS=0xYourPrivateKeyHere

FREE_MINTS_ONLY=true
DRY_RUN=true
POLL_INTERVAL_SEC=1.0
GAS_LIMIT=500000
WALLET_STATE_REFRESH_SEC=5
WALLET_STATE_TTL_SEC=15
MAX_CATCHUP_BLOCKS=100
