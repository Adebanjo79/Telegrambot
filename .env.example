# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Your Telegram numeric user id (from @userinfobot). Only this user can control the bot.
TELEGRAM_OWNER_ID=123456789

# Robinhood Chain RPC
# Public RPC works but is rate-limited and may drop connections.
# For stable watching, use a paid node (Chainstack/Alchemy/QuickNode).
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: several endpoints, comma-separated. Overrides RPC_URL.
# Mix providers so one outage or rate limit can't stop the bot, e.g.
# Chainstack + Alchemy (https://robinhood-mainnet.g.alchemy.com/v2/KEY).
# RPC_URLS=https://node-1.example.com/key,https://robinhood-mainnet.g.alchemy.com/v2/KEY

# true = share requests across every RPC_URLS entry (each node sees ~half the
# traffic). false = use the first node and keep the rest as backups only.
RPC_LOAD_BALANCE=true

# Your plan's requests/second cap. Telegram warns before you reach it.
RPC_RATE_LIMIT=25
# Warn once usage passes this share of the cap.
RPC_WARN_PERCENT=80
# Warn when average RPC response time goes above this (milliseconds).
RPC_SLOW_MS=1500
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Wallet(s) you want to COPY — comma-separated allowed
TARGET_WALLETS=0xTargetWalletAddressHere

# YOUR minting wallet private key(s) in .env (base wallets).
# One wallet:
#   PRIVATE_KEY=0xYourPrivateKeyHere
# OR multiple:
#   PRIVATE_KEYS=0xKey1,0xKey2
# You can also add more later from Telegram:
#   /addwallet 0xAnotherPrivateKey
PRIVATE_KEYS=0xYourPrivateKeyHere

# true = only copy txs with 0 ETH value (free mints). false = also copy paid mints (you pay the same value).
FREE_MINTS_ONLY=true

# true = detect + notify + simulate only — do NOT broadcast copy txs
DRY_RUN=true

# How often to poll new blocks (seconds). Use 1.5–2.0 on public RPC.
POLL_INTERVAL_SEC=1.5

# Max gas limit for copy mints
GAS_LIMIT=500000

# How many recent blocks to scan on each catch-up (keeps CPU/RPC load bounded)
MAX_CATCHUP_BLOCKS=25
