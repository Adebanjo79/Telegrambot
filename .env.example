# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Your Telegram numeric user id (from @userinfobot). Only this user can control the bot.
TELEGRAM_OWNER_ID=123456789

# Robinhood Chain RPC
# Public RPC works but is rate-limited and may drop connections.
# For stable watching, use Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Wallet(s) you want to COPY — comma-separated allowed
TARGET_WALLETS=0xTargetWalletAddressHere

# YOUR wallet private key (never share / never commit). Fund with ETH for gas on Robinhood Chain.
PRIVATE_KEY=0xYourPrivateKeyHere

# true = only copy txs with 0 ETH value (free mints). false = also copy paid mints (you pay the same value).
FREE_MINTS_ONLY=true

# true = detect + notify + simulate only — do NOT broadcast copy txs
DRY_RUN=true

# How often to poll new blocks (seconds). Use 1.5–2.0 on public RPC.
POLL_INTERVAL_SEC=1.5

# Max gas limit for copy mints
GAS_LIMIT=500000

# How many recent blocks to scan on each catch-up (keeps CPU/RPC load bounded)
MAX_CATCHUP_BLOCKS=25
